# Frontal HTTPS de DeeKeep. Le service worker (application installable,
# fonctionnement hors ligne) exige HTTPS : choisir UNE des deux variantes.
#
# 1) Nom de domaine public pointant sur la box (certificat Let's Encrypt automatique) :
#      musique.example.fr {
#          import deekeep
#      }
#
# 2) Réseau local uniquement (autorité interne de Caddy ; installer son
#    certificat racine /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
#    sur le téléphone et l'ordinateur) :
#      deekeep.local, 192.168.1.50 {
#          tls internal
#          import deekeep
#      }

(deekeep) {
	# Les flux audio et le flux d'événements (SSE) ne doivent être ni compressés
	# ni mis en tampon.
	@stream path /media/* /archive-media/* /preview/* /api/events
	@compress not path /media/* /archive-media/* /preview/* /api/events
	encode @compress zstd gzip
	reverse_proxy @stream 127.0.0.1:5000 {
		flush_interval -1
	}
	# Un rechargement de Caddy coupe le flux d'événements : le client se
	# reconnecte de lui-même.
	reverse_proxy 127.0.0.1:5000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Les fichiers de assets/ portent une empreinte dans leur nom : cache permanent.
	# La coquille et le service worker doivent toujours être revalidés.
	@static path /assets/* *.woff2 *.svg *.png
	header @static Cache-Control "public, max-age=31536000, immutable"
	@shell path /index.html /sw.js /workbox-*.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"
}

{$DEEKEEP_SITE:deekeep.local} {
	tls internal
	import deekeep
}
