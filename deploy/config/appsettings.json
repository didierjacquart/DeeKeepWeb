{
  "Database": {
    "MainPath": "/var/lib/deekeep/deekeep_cache.db",
    "WebPath": "/var/lib/deekeep/deekeep_web.db",
    "BusyTimeoutMs": 8000
  },
  "PathMap": {
    "Mappings": [
      { "From": "D:\\", "To": "/srv/musique/" }
    ]
  },
  "Library": {
    "BrowseRoots": [ "/srv/musique" ]
  },
  "Storage": {
    "ArchiveRoot": "/mnt/archive"
  },
  "Catalog": {
    "CacheDir": "/var/cache/deekeep/catalog"
  },
  "Import": {
    "DesktopDataDir": "/var/lib/deekeep/import"
  },
  "Tools": {
    "Ffmpeg": "/usr/bin/ffmpeg",
    "Ffprobe": "/usr/bin/ffprobe",
    "YtDlp": "/opt/deekeep/tools/yt-dlp",
    "Deno": "/opt/deekeep/tools/deno",
    "Fpcalc": "/usr/bin/fpcalc",
    "Niceness": 10
  },
  "Jobs": {
    "downloader": { "Concurrency": { "download": 2, "convert": 1, "redownload": 1 } },
    "quality": { "Concurrency": { "quality.scan": 1 } },
    "library": { "Concurrency": { "organize.apply": 1, "library.scan": 1 } },
    "storage": { "Concurrency": { "archive.upload": 1, "archive.restore": 1 } }
  },
  "Auth": {
    "Enabled": true,
    "SessionLifetime": "60.00:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Error",
      "Yarp": "Warning"
    }
  }
}
