# Un microservice DeeKeep (instance = nom du service : Gateway, Catalog, Library,
# Downloader, Quality, Storage). Installé par deploy/install.sh.
[Unit]
Description=DeeKeep %i
After=network-online.target
Wants=network-online.target
PartOf=deekeep.target
# Au-delà de 10 échecs en 10 minutes, systemd cesse de relancer : le
# contrôle de santé (deekeep-health.timer) prend le relais plus tard.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=notify
User=deekeep
Group=deekeep
WorkingDirectory=/opt/deekeep/%i
ExecStart=/usr/share/dotnet/dotnet /opt/deekeep/%i/DeeKeep.%i.dll
EnvironmentFile=-/etc/deekeep/environment
Environment=DEEKEEP_CONFIG=/etc/deekeep/appsettings.json
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Machine peu puissante : GC poste de travail, tas le plus compact possible.
Environment=DOTNET_gcServer=0
Environment=DOTNET_GCConserveMemory=7
Environment=DOTNET_TieredPGO=1
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30
# Les tâches en cours sont reprises au redémarrage : un arrêt franc ne perd rien.
KillSignal=SIGTERM
MemoryHigh=280M
MemoryMax=400M

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/deekeep /var/cache/deekeep

[Install]
WantedBy=deekeep.target
